# Cairn Environment Configuration
# Copy to .env and fill in values

# Core Gateway
HOST=0.0.0.0
PORT=3100
GATEWAY_URL=http://localhost:3100
DASHBOARD_URL=http://localhost:5173
GATEWAY_PORT=3100

# OpenAI (required for LLM + embeddings)
OPENAI_API_KEY=sk-your-key-here

# Google integrations (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Telegram integration (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Scheduler / policy tuning (optional)
HEARTBEAT_INTERVAL_MS=60000
MONTHLY_SPEND_LIMIT_USD=50
MAX_DECISIONS_PER_DAY=10
MAX_INTERACTIONS_PER_DAY=5

# Mobile client options (optional)
MOBILE_APP_ENABLED=false
DEFAULT_CLIENT=telegram
MOBILE_PAIRING_SECRET=
MOBILE_AUTH_TOKEN=

# Optional dashboard WebSocket auth token for non-local access
DASHBOARD_AUTH_TOKEN=

# Dashboard frontend (Vite) must receive the same token when remote auth is enabled
VITE_DASHBOARD_AUTH_TOKEN=

# Runtime mode (optional)
NODE_ENV=development

# Executor tool runtime selection:
# - fallback (default): use legacy tools; manifest when legacy unavailable
# - prefer: try manifest for mapped tools, fall back to legacy on failure
# - strict: only manifest for mapped tools, fail if manifest execution fails
EXECUTOR_MANIFEST_MODE=fallback

# Data directory override (optional, defaults to ./data)
# CAIRN_ROOT=/path/to/cairn
