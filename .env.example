# Cairn Environment Configuration
# Copy to .env and fill in values

# Gateway
PORT=3100
HOST=0.0.0.0

# OpenAI (required for AI features)
OPENAI_API_KEY=sk-your-key-here

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Scheduler (optional, default 60s)
HEARTBEAT_INTERVAL_MS=60000

# Data directory override (optional, defaults to ./data)
# CAIRN_ROOT=/path/to/cairn
