# Cairn Gateway - systemd service template
#
# Install: sudo cp scripts/cairn-gateway.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable cairn-gateway
#
# Port 3100 (gateway API + WebSocket)
# Reads .env from WorkingDirectory for OPENAI_API_KEY, TELEGRAM_*, etc.

[Unit]
Description=Cairn Gateway
After=network.target

[Service]
Type=simple
User=cairn
WorkingDirectory=/home/cairn/Cairn
EnvironmentFile=-/home/cairn/Cairn/.env
Environment="NODE_ENV=production"
Environment="PORT=3100"
Environment="HOST=0.0.0.0"
ExecStart=/usr/bin/node apps/gateway/dist/index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
