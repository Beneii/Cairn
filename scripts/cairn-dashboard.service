# Cairn Dashboard - systemd service template
#
# Install: sudo cp scripts/cairn-dashboard.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable cairn-dashboard
#
# Port 5173 (serves the built dashboard static files)
# Requires: pnpm build to have been run first
# Requires: npx serve (or install globally: npm i -g serve)

[Unit]
Description=Cairn Dashboard
After=network.target cairn-gateway.service

[Service]
Type=simple
User=cairn
WorkingDirectory=/home/cairn/Cairn/apps/dashboard
ExecStart=/usr/bin/npx serve -s dist -l 5173
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
