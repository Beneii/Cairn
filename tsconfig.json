{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@cairn/*": [
        "packages/*/src",
        "apps/*/src"
      ]
    }
  },
  "exclude": [
    "scripts",
    "node_modules",
    "dist",
    "**/dist"
  ]
}