# Cairn Dashboard Configuration
# Copy to .env and fill in values
# All values are auto-detected from window.location if not set

# Override WebSocket URL (auto-detected if not set)
# VITE_WS_URL=ws://localhost:3100/ws

# Override API URL (auto-detected if not set)
# VITE_API_URL=http://localhost:3100

# Mode: local | remote | prod
VITE_CAIRN_MODE=local
